<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StoreDevice.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:StoreDevice.App.Pages"
    Title="Store Device"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"
    Shell.BackgroundColor="#0B0F14"
    Shell.ForegroundColor="#5AA9FF">

    <ShellContent
        Route="onboarding"
        ContentTemplate="{DataTemplate pages:OnboardingPage}" />

    <ShellContent
        Route="board"
        ContentTemplate="{DataTemplate pages:BoardPage}" />

</Shell>
