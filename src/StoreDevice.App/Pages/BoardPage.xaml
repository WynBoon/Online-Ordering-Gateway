<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreDevice.App.Pages.BoardPage"
             BackgroundColor="#1C1917">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Label x:Name="StoreLabel" TextColor="#F59E0B" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="FunctionsLabel" TextColor="#A8A29E" FontSize="14" />
            <HorizontalStackLayout Spacing="12">
                <Button Text="Refresh" Clicked="OnRefreshClicked"
                        BackgroundColor="#44403C" TextColor="White" HeightRequest="48" />
                <Button Text="Unpair" Clicked="OnUnpairClicked"
                        BackgroundColor="#44403C" TextColor="#F59E0B" HeightRequest="48" />
            </HorizontalStackLayout>
            <Label x:Name="ErrorLabel" TextColor="#EF4444" FontSize="16" />
        </VerticalStackLayout>

        <CollectionView x:Name="OrdersView" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnOrderSelected">
            <CollectionView.EmptyView>
                <Label Text="No open orders. New channel orders still print on the till; this screen is the status path."
                       TextColor="#A8A29E"
                       FontSize="16"
                       Margin="8" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12" Margin="0,0,0,8" BackgroundColor="#292524" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="{Binding DisplayId}" TextColor="White" FontSize="22" FontAttributes="Bold" />
                            <Label Text="{Binding CustomerName}" TextColor="#A8A29E" FontSize="16" />
                            <Label Text="{Binding Fulfillment}" TextColor="#A8A29E" FontSize="14" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Status}" TextColor="#F59E0B" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
