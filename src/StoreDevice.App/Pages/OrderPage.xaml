<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StoreDevice.App.Pages.OrderPage"
             BackgroundColor="#0B0F14">
    <Grid RowDefinitions="Auto,*">
        <Grid Padding="16,12" ColumnDefinitions="Auto,*" BackgroundColor="#121820" HeightRequest="72">
            <Button Text="Back"
                    Clicked="OnBack"
                    BackgroundColor="#232D39"
                    TextColor="#F3F6FA"
                    HeightRequest="56"
                    WidthRequest="100"
                    CornerRadius="14" />
            <VerticalStackLayout Grid.Column="1" Margin="16,0,0,0" VerticalOptions="Center">
                <Label x:Name="NumberLabel" TextColor="#F3F6FA" FontSize="28" FontFamily="OpenSansSemibold" />
                <Label x:Name="IdentityLabel" TextColor="#B4BFCC" FontSize="16" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="12">
                <HorizontalStackLayout Spacing="8">
                    <Border Stroke="#66778A" StrokeThickness="1" StrokeShape="RoundRectangle 999" Padding="12,6">
                        <Label x:Name="FulfillmentLabel" TextColor="#B4BFCC" FontSize="14" />
                    </Border>
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 999" Padding="12,6" BackgroundColor="#232D39">
                        <Label x:Name="TimerLabel" TextColor="#F3F6FA" FontSize="14" FontFamily="OpenSansSemibold" />
                    </Border>
                </HorizontalStackLayout>

                <Label x:Name="SyncLabel" TextColor="#8593A3" FontSize="14" />

                <Border x:Name="NoteBox"
                        Stroke="#FFB454"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        Padding="12"
                        IsVisible="False">
                    <Label x:Name="NotesLabel" TextColor="#FFB454" FontSize="16" FontAttributes="Italic" />
                </Border>

                <VerticalStackLayout x:Name="LinesStack" Spacing="8" />

                <Button x:Name="PrimaryButton"
                        Clicked="OnPrimary"
                        TextColor="#06121F"
                        FontAttributes="Bold"
                        FontSize="18"
                        HeightRequest="64"
                        CornerRadius="14" />

                <Button x:Name="DelayButton"
                        Text="Add 5 minutes"
                        Clicked="OnDelay"
                        BackgroundColor="Transparent"
                        BorderColor="#66778A"
                        BorderWidth="1"
                        TextColor="#F3F6FA"
                        HeightRequest="56"
                        CornerRadius="14" />

                <Button x:Name="CancelButton"
                        Text="Decline / cancel"
                        Clicked="OnCancel"
                        BackgroundColor="Transparent"
                        BorderColor="#FF6B6B"
                        BorderWidth="1"
                        TextColor="#FF6B6B"
                        HeightRequest="56"
                        CornerRadius="14" />

                <Label x:Name="ErrorLabel" TextColor="#FF6B6B" FontSize="16" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
