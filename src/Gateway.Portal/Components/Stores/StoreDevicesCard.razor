@rendermode InteractiveServer
@using Gateway.Application.Devices
@using Gateway.Application.Repositories
@using Gateway.Application.UseCases
@using Gateway.Domain.Devices
@using Gateway.Domain.Enums
@inject DeviceEnrollmentUseCase Enrollment
@inject IStoreRepository Stores
@inject IStoreDeviceRepository Devices
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<MudPaper Class="pa-4 mt-4" Elevation="1">
    <div class="d-flex justify-space-between align-start flex-wrap gap-3 mb-2">
        <div>
            <MudText Typo="Typo.h6">In-store devices</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                @if (PosType == PosType.Gaap)
                {
                    <text>This POS cannot send kitchen status back. Pair a tablet as the status of record for Order Harmony.</text>
                }
                else
                {
                    <text>This POS can callback in principle. A tablet is still useful as a backup status path.</text>
                }
            </MudText>
        </div>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
            @(_devices.Count(d => d.Status != DeviceStatus.Revoked) == 1
                ? "1 tablet"
                : $"{_devices.Count(d => d.Status != DeviceStatus.Revoked)} tablets")
        </MudChip>
    </div>

    <MudExpansionPanels Class="mb-4" Elevation="0">
        <MudExpansionPanel Text="Functions granted to new devices" Dense="true">
            <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);" Class="mb-2">
                Saved onto each new pairing code. Changing this later does not widen a device that is already issued or paired.
            </MudText>
            <MudStack Spacing="1" Class="mb-3">
                @foreach (var descriptor in DeviceFunctionCatalog.All)
                {
                    var flag = descriptor.Flag;
                    <MudCheckBox T="bool"
                                 Value="@_defaults.HasFlag(flag)"
                                 ValueChanged="@(on => ToggleDefault(flag, on))"
                                 Label="@($"{descriptor.Title} — {descriptor.Description}")"
                                 Dense="true" />
                }
            </MudStack>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="SaveDefaultsAsync">
                Save store default
            </MudButton>
        </MudExpansionPanel>
    </MudExpansionPanels>

    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mb-4 flex-wrap">
        <MudTextField T="string"
                      @bind-Value="_deviceName"
                      Label="Device name"
                      Placeholder="Pass kitchen"
                      Class="flex-grow-1"
                      Style="min-width: 16rem;" />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.QrCode"
                   OnClick="IssueAsync"
                   Disabled="@_busy">
            Issue pairing code
        </MudButton>
    </MudStack>

    @if (_issued is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="() => _issued = null">
            <MudText Typo="Typo.subtitle2">Enter this code on the tablet — shown once</MudText>
            <MudText Typo="Typo.h3" Style="letter-spacing: 0.35em; font-variant-numeric: tabular-nums;">@_issued.EnrollmentCode</MudText>
            <MudText Typo="Typo.body2">
                Expires @_issued.ExpiresAtUtc.ToLocalTime().ToString("t"). Waiting to pair as “@_deviceName”.
            </MudText>
        </MudAlert>
    }

    <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
        <MudText Typo="Typo.subtitle1">Paired tablets</MudText>
        @if (_revokedCount > 0)
        {
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       Color="Color.Default"
                       StartIcon="@(_showRevoked ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                       OnClick="ToggleShowRevoked">
                @(_showRevoked ? "Hide revoked" : $"Show revoked ({_revokedCount})")
            </MudButton>
        }
    </div>

    @if (_visibleDevices.Count == 0)
    {
        <MudPaper Outlined="true" Class="pa-6 text-center">
            <MudIcon Icon="@Icons.Material.Outlined.TabletMac" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
            <MudText Typo="Typo.subtitle1">No tablets on this store</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">
                @if (_revokedCount > 0 && !_showRevoked)
                {
                    <text>@_revokedCount revoked @(_revokedCount == 1 ? "device is" : "devices are") hidden. Turn on Show revoked to remove them from the list.</text>
                }
                else
                {
                    <text>Issue a pairing code, then enter it on the kitchen tablet within 15 minutes.</text>
                }
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudStack Spacing="2">
            @foreach (var device in _visibleDevices)
            {
                var editing = _editingId == device.Id;
                var revoked = device.Status == DeviceStatus.Revoked;
                <MudPaper Outlined="true" Class="pa-4">
                    <div class="d-flex justify-space-between align-start flex-wrap gap-2">
                        <div class="d-flex align-start gap-3">
                            <MudAvatar Color="@StatusColor(device)" Variant="Variant.Filled" Size="Size.Medium">
                                <MudIcon Icon="@DeviceIcon(device)" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1">@device.Name</MudText>
                                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary);">@StatusDetail(device)</MudText>
                            </div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="@StatusColor(device)">@StatusLabel(device)</MudChip>
                    </div>

                    <div class="mt-3">
                        @if (editing && !revoked)
                        {
                            <MudStack Spacing="0">
                                @foreach (var descriptor in DeviceFunctionCatalog.All)
                                {
                                    var current = device;
                                    var flag = descriptor.Flag;
                                    <MudCheckBox T="bool"
                                                 Value="@current.Functions.HasFlag(flag)"
                                                 ValueChanged="@(on => ToggleDeviceAsync(current, flag, on))"
                                                 Label="@($"{descriptor.Title} — {descriptor.Description}")"
                                                 Dense="true" />
                                }
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                                @foreach (var descriptor in GrantedFunctions(device))
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@descriptor.Title</MudChip>
                                }
                            </MudStack>
                            @if (!revoked && !device.Functions.HasFlag(DeviceFunction.MarkPreparing)
                                 && !device.Functions.HasFlag(DeviceFunction.MarkReady)
                                 && !device.Functions.HasFlag(DeviceFunction.MarkCompleted))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Warning" Class="mt-1">
                                    No kitchen status functions granted — this tablet cannot update Order Harmony.
                                </MudText>
                            }
                        }
                    </div>

                    <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-3 flex-wrap">
                        @if (revoked)
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Delete"
                                       OnClick="() => RemoveAsync(device)">
                                Remove from list
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Text"
                                       Size="Size.Small"
                                       StartIcon="@(editing ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.Tune)"
                                       OnClick="() => _editingId = editing ? null : device.Id">
                                @(editing ? "Done" : "Edit functions")
                            </MudButton>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.LinkOff"
                                       OnClick="() => RevokeAsync(device)">
                                @(device.Status == DeviceStatus.PendingEnrollment ? "Cancel code" : "Revoke")
                            </MudButton>
                        }
                    </MudStack>
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [Parameter]
    public Guid StoreId { get; set; }

    [Parameter]
    public PosType PosType { get; set; }

    private DeviceFunction _defaults = DeviceFunctionSets.KitchenStatusOfRecord;
    private string _deviceName = "Pass kitchen";
    private IReadOnlyList<StoreDevice> _devices = [];
    private IssuedEnrollment? _issued;
    private bool _busy;
    private bool _showRevoked;
    private Guid? _editingId;
    private Guid _loadedFor;

    private int _revokedCount => _devices.Count(d => d.Status == DeviceStatus.Revoked);

    private IReadOnlyList<StoreDevice> _visibleDevices =>
        _devices
            .Where(d => _showRevoked || d.Status != DeviceStatus.Revoked)
            .OrderBy(SortKey)
            .ThenBy(d => d.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == StoreId)
        {
            return;
        }

        await ReloadAsync();
        _loadedFor = StoreId;
    }

    private async Task ReloadAsync()
    {
        var store = await Stores.GetByIdAsync(StoreId, CancellationToken.None);
        if (store is not null)
        {
            _defaults = store.DefaultDeviceFunctions;
        }

        _devices = await Devices.ListByStoreAsync(StoreId, CancellationToken.None);
        if (_editingId is { } editing && _devices.All(d => d.Id != editing))
        {
            _editingId = null;
        }
    }

    private void ToggleShowRevoked() => _showRevoked = !_showRevoked;

    private void ToggleDefault(DeviceFunction flag, bool on)
    {
        _defaults = on ? _defaults | flag : _defaults & ~flag;
    }

    private async Task SaveDefaultsAsync()
    {
        await Stores.UpdateDefaultDeviceFunctionsAsync(StoreId, _defaults, CancellationToken.None);
        Snackbar.Add("Store default functions saved. New pairing codes will copy them.", Severity.Success);
    }

    private async Task IssueAsync()
    {
        _busy = true;
        try
        {
            _issued = await Enrollment.IssueAsync(StoreId, _defaults, _deviceName, CancellationToken.None);
            await ReloadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleDeviceAsync(StoreDevice device, DeviceFunction flag, bool on)
    {
        var next = on ? device.Functions | flag : device.Functions & ~flag;
        try
        {
            await Enrollment.UpdateFunctionsAsync(device.Id, next, CancellationToken.None);
            device.Functions = next;
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RevokeAsync(StoreDevice device)
    {
        var pending = device.Status == DeviceStatus.PendingEnrollment;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            pending ? "Cancel pairing code?" : "Revoke this tablet?",
            pending
                ? $"“{device.Name}” will no longer be able to pair with the code that was issued."
                : $"“{device.Name}” will stop immediately. Heartbeat, open orders, and status taps will be rejected. Issue a new code to replace it.",
            yesText: pending ? "Cancel code" : "Revoke",
            cancelText: "Keep");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Enrollment.RevokeAsync(device.Id, CancellationToken.None);
            await ReloadAsync();
            Snackbar.Add(
                pending
                    ? "Pairing code cancelled. Turn on Show revoked to remove the row."
                    : "Device revoked. It is hidden from this list — turn on Show revoked to remove it.",
                Severity.Info);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveAsync(StoreDevice device)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Remove from this store?",
            $"“{device.Name}” is already revoked. This permanently removes the row from the store — the tablet cannot be used again.",
            yesText: "Remove",
            cancelText: "Keep");
        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Enrollment.RemoveAsync(device.Id, CancellationToken.None);
            await ReloadAsync();
            Snackbar.Add("Revoked device removed from the list.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private static IEnumerable<DeviceFunctionDescriptor> GrantedFunctions(StoreDevice device) =>
        DeviceFunctionCatalog.All.Where(d => device.Functions.HasFlag(d.Flag));

    private static int SortKey(StoreDevice device)
    {
        var now = DateTimeOffset.UtcNow;
        if (device.Status == DeviceStatus.Active && device.IsOnline(now))
        {
            return 0;
        }

        return device.Status switch
        {
            DeviceStatus.PendingEnrollment => 1,
            DeviceStatus.Active => 2,
            DeviceStatus.Suspended => 3,
            DeviceStatus.Revoked => 4,
            _ => 5
        };
    }

    private static string StatusLabel(StoreDevice device)
    {
        var now = DateTimeOffset.UtcNow;
        return device.Status switch
        {
            DeviceStatus.PendingEnrollment when IsExpired(device, now) => "Code expired",
            DeviceStatus.PendingEnrollment => "Waiting to pair",
            DeviceStatus.Active when device.IsOnline(now) => "Online",
            DeviceStatus.Active => "Offline",
            DeviceStatus.Suspended => "Suspended",
            DeviceStatus.Revoked => "Revoked",
            _ => device.Status.ToString()
        };
    }

    private static string StatusDetail(StoreDevice device)
    {
        var now = DateTimeOffset.UtcNow;
        return device.Status switch
        {
            DeviceStatus.PendingEnrollment when IsExpired(device, now) => "Issue a new pairing code.",
            DeviceStatus.PendingEnrollment when device.EnrollmentExpiresAtUtc is { } expires =>
                $"Code expires {expires.ToLocalTime():t}",
            DeviceStatus.PendingEnrollment => "Waiting for the tablet to enter the code.",
            DeviceStatus.Revoked when device.RevokedAtUtc is { } revoked =>
                $"Revoked {Relative(revoked)}",
            DeviceStatus.Revoked => "Token cleared — this tablet cannot call the gateway.",
            _ when device.LastHeartbeatAtUtc is { } beat => $"Last seen {Relative(beat)}",
            _ => "Never seen"
        };
    }

    private static Color StatusColor(StoreDevice device)
    {
        var now = DateTimeOffset.UtcNow;
        return device.Status switch
        {
            DeviceStatus.PendingEnrollment when IsExpired(device, now) => Color.Default,
            DeviceStatus.PendingEnrollment => Color.Warning,
            DeviceStatus.Active when device.IsOnline(now) => Color.Success,
            DeviceStatus.Active => Color.Info,
            DeviceStatus.Suspended => Color.Dark,
            DeviceStatus.Revoked => Color.Error,
            _ => Color.Default
        };
    }

    private static string DeviceIcon(StoreDevice device) =>
        device.Status == DeviceStatus.Revoked
            ? Icons.Material.Filled.PhonelinkErase
            : Icons.Material.Filled.TabletMac;

    private static bool IsExpired(StoreDevice device, DateTimeOffset now) =>
        device.EnrollmentExpiresAtUtc is { } expires && expires < now;

    private static string Relative(DateTimeOffset utc)
    {
        var delta = DateTimeOffset.UtcNow - utc;
        if (delta.TotalSeconds < 45)
        {
            return "just now";
        }

        if (delta.TotalMinutes < 60)
        {
            return $"{Math.Max(1, (int)delta.TotalMinutes)} min ago";
        }

        if (delta.TotalHours < 24)
        {
            return $"{(int)delta.TotalHours}h ago";
        }

        return utc.ToLocalTime().ToString("g");
    }
}
