@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Dashboard" Color="Color.Inherit" Href="/" Edge="Edge.Start" title="Command centre" />
        <MudText Typo="Typo.h6">
            <MudLink Href="/" Color="Color.Inherit" Underline="Underline.None">Order Gateway</MudLink>
        </MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Store" Color="Color.Inherit" Href="/stores" title="Stores" />
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
