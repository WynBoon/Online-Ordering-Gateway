@page "/"
@rendermode InteractiveServer
@using Gateway.Application.Repositories
@using Gateway.Domain.Enums
@using Gateway.Domain.Events
@using Gateway.Domain.Orders
@using Gateway.Domain.Tenancy
@using Gateway.Portal.Services
@inject IStoreRepository StoreRepository
@inject IOrderRepository OrderRepository
@inject LiveOrderFeedService LiveFeed
@inject PlatformHealthService PlatformHealth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Command Centre</PageTitle>

@* The home screen is a command centre, not a tile dashboard — exception-first,
   not volume-first (UI-ARCHITECTURE.md, "Decided"). Fleet status grid, live
   ticker, exceptions sorted to the top, rolling KPIs with trend. *@

<div class="d-flex justify-space-between align-center mb-2 flex-wrap gap-2">
    <MudText Typo="Typo.h4">Command Centre</MudText>
    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="RefreshHealthAsync" Disabled="_healthLoading">
        Refresh health
    </MudButton>
</div>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudText Typo="Typo.subtitle2" Class="mb-2">Platform health</MudText>
    @if (_healthLoading && _health.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">Checking dependencies…</MudText>
    }
    else
    {
        <MudStack Row="true" Spacing="2" Class="flex-wrap">
            @foreach (var item in _health)
            {
                <MudTooltip Text="@(item.Detail ?? item.Name)">
                    <MudChip T="string" Size="Size.Small" Color="@HealthColor(item.Status)" Icon="@HealthIcon(item.Status)">
                        @item.Name: @item.Status
                    </MudChip>
                </MudTooltip>
            }
        </MudStack>
    }
</MudPaper>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2">Orders today</MudText>
            <MudText Typo="Typo.h4">@_ordersToday</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2">Success rate (1h)</MudText>
            <MudText Typo="Typo.h4">@(_successRateLastHour is null ? "—" : $"{_successRateLastHour:P0}")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2">Stores needing attention</MudText>
            <MudText Typo="Typo.h4" Color="@(_attentionStores.Count > 0 ? Color.Error : Color.Success)">@_attentionStores.Count</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.subtitle2">Active stores</MudText>
            <MudText Typo="Typo.h4">@_stores.Count(s => s.State == StoreState.Active) / @_stores.Count</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_attentionStores.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">
        Needs attention: @string.Join(", ", _attentionStores.Select(s => s.Name))
    </MudAlert>
}

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Fleet</MudText>
<MudGrid>
    @foreach (var store in _stores.OrderBy(FleetSortKey))
    {
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Elevation="1" Style="@($"border-left: 6px solid {StateColorHex(store.State)}; cursor: pointer")"
                      @onclick="@(() => Nav.NavigateTo($"/stores/{store.Id}"))">
                <MudText Typo="Typo.subtitle1">@store.Name</MudText>
                <MudChip T="string" Size="Size.Small" Color="@StateColor(store.State)">@store.State</MudChip>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Live feed</MudText>
<MudPaper Class="pa-3" Elevation="1" Style="max-height: 320px; overflow-y: auto;">
    @if (_liveEvents.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">No activity yet.</MudText>
    }
    else
    {
        @foreach (var evt in _liveEvents)
        {
            <div class="d-flex justify-space-between py-1 align-center" style="cursor: pointer"
                 @onclick="@(() => Nav.NavigateTo($"/orders/{Uri.EscapeDataString(evt.OrderRef)}"))">
                <MudText Typo="Typo.body2">
                    @evt.EventTimeUtc.ToLocalTime().ToString("T")
                    — @StoreName(evt.StoreId)
                    — @evt.OrderRef
                    — @evt.EventType
                    @if (!string.IsNullOrWhiteSpace(evt.Detail))
                    {
                        <text> · @Truncate(evt.Detail, 80)</text>
                    }
                </MudText>
                <MudChip T="string" Size="Size.Small" Color="@(IsSuccess(evt) ? Color.Success : Color.Error)">
                    @(evt.Status?.ToString() ?? evt.Outcome ?? "—")
                </MudChip>
            </div>
        }
    }
</MudPaper>

<MudText Typo="Typo.h6" Class="mt-6 mb-2">Recent orders</MudText>
<MudTable Items="_recentOrders" Hover="true" Dense="true">
    <HeaderContent>
        <MudTh>Order ref</MudTh>
        <MudTh>Store</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>POS id</MudTh>
        <MudTh>Placed</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Order ref">
            <MudLink Href="@($"/orders/{Uri.EscapeDataString(context.OrderRef)}")">@context.OrderRef</MudLink>
        </MudTd>
        <MudTd DataLabel="Store">@StoreName(context.StoreId)</MudTd>
        <MudTd DataLabel="Status">@context.Status</MudTd>
        <MudTd DataLabel="POS id">@(context.PosOrderId ?? "—")</MudTd>
        <MudTd DataLabel="Placed">@context.PlacedAtUtc.ToLocalTime().ToString("g")</MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<Store> _stores = [];
    private List<Store> _attentionStores = [];
    private readonly List<OrderEvent> _liveEvents = [];
    private readonly HashSet<string> _seenEventIds = new(StringComparer.Ordinal);
    private List<CanonicalOrder> _recentOrders = [];
    private int _ordersToday;
    private double? _successRateLastHour;
    private IReadOnlyList<PlatformHealthItem> _health = [];
    private bool _healthLoading;

    protected override async Task OnInitializedAsync()
    {
        _stores = (await StoreRepository.GetAllAsync(CancellationToken.None)).ToList();
        _attentionStores = _stores.Where(s => s.State == StoreState.Paused).ToList();

        _ordersToday = await OrderRepository.CountOrdersTodayAsync(CancellationToken.None);
        _successRateLastHour = await OrderRepository.GetSuccessRateLastHourAsync(CancellationToken.None);
        _recentOrders = (await OrderRepository.GetRecentOrdersAsync(25, CancellationToken.None)).ToList();

        foreach (var evt in await OrderRepository.GetRecentEventsAsync(50, CancellationToken.None))
        {
            MergeEvent(evt);
        }

        LiveFeed.OrderEventReceived += OnLiveEventAsync;

        _ = LoadHealthAsync(forceRefresh: false);
    }

    private async Task LoadHealthAsync(bool forceRefresh)
    {
        _healthLoading = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            _health = await PlatformHealth.GetAsync(forceRefresh, CancellationToken.None);
        }
        finally
        {
            _healthLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task RefreshHealthAsync() => LoadHealthAsync(forceRefresh: true);

    private Task OnLiveEventAsync(OrderEvent evt)
    {
        return InvokeAsync(() =>
        {
            if (!MergeEvent(evt))
            {
                return;
            }

            if (evt.EventTimeUtc.Date == DateTimeOffset.UtcNow.Date
                && string.Equals(evt.EventType, "order.status_changed", StringComparison.Ordinal)
                && string.Equals(evt.Outcome, "success", StringComparison.OrdinalIgnoreCase))
            {
                // Prefer not double-counting SQL-seeded orders; only bump for brand-new live accepts
                // when we do not already have this order in the recent list.
                if (_recentOrders.All(o => o.OrderRef != evt.OrderRef))
                {
                    _ordersToday++;
                }
            }

            StateHasChanged();
        });
    }

    private bool MergeEvent(OrderEvent evt)
    {
        if (!_seenEventIds.Add(evt.EventId))
        {
            return false;
        }

        _liveEvents.Insert(0, evt);
        if (_liveEvents.Count > 50)
        {
            var removed = _liveEvents[^1];
            _liveEvents.RemoveAt(_liveEvents.Count - 1);
            _seenEventIds.Remove(removed.EventId);
        }

        return true;
    }

    private string StoreName(Guid storeId) =>
        _stores.FirstOrDefault(s => s.Id == storeId)?.Name ?? storeId.ToString()[..8];

    private static bool IsSuccess(OrderEvent evt) =>
        string.Equals(evt.Outcome, "success", StringComparison.OrdinalIgnoreCase);

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : value[..max] + "…";

    private static Color HealthColor(PlatformHealthStatus status) => status switch
    {
        PlatformHealthStatus.Ok => Color.Success,
        PlatformHealthStatus.Degraded => Color.Warning,
        PlatformHealthStatus.Fail => Color.Error,
        _ => Color.Default
    };

    private static string HealthIcon(PlatformHealthStatus status) => status switch
    {
        PlatformHealthStatus.Ok => Icons.Material.Filled.CheckCircle,
        PlatformHealthStatus.Degraded => Icons.Material.Filled.Warning,
        PlatformHealthStatus.Fail => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.HelpOutline
    };

    private static int FleetSortKey(Store s) => s.State switch
    {
        StoreState.Paused => 0,
        StoreState.Draft => 1,
        StoreState.Active => 2,
        StoreState.Deactivated => 3,
        _ => 4
    };

    private static Color StateColor(StoreState state) => state switch
    {
        StoreState.Active => Color.Success,
        StoreState.Paused => Color.Error,
        StoreState.Draft => Color.Default,
        StoreState.Deactivated => Color.Dark,
        _ => Color.Default
    };

    private static string StateColorHex(StoreState state) => state switch
    {
        StoreState.Active => "var(--mud-palette-success)",
        StoreState.Paused => "var(--mud-palette-error)",
        StoreState.Draft => "var(--mud-palette-grey-500)",
        StoreState.Deactivated => "var(--mud-palette-dark)",
        _ => "transparent"
    };

    public void Dispose()
    {
        LiveFeed.OrderEventReceived -= OnLiveEventAsync;
    }
}
