@page "/stores/new"
@rendermode InteractiveServer
@using Gateway.Application.Ports
@using Gateway.Application.Repositories
@using Gateway.Domain.Enums
@using Gateway.Domain.Tenancy
@using Microsoft.Extensions.DependencyInjection
@inject IStoreRepository StoreRepository
@inject Gateway.Infrastructure.Persistence.GatewayDbContext Db
@inject IServiceProvider Services
@inject NavigationManager Nav

<PageTitle>Onboard store</PageTitle>

@* One form, five sections — matches the onboarding sequence in ARCHITECTURE.md §7:
   create -> attach to Group (optional) -> configure connections -> billing ->
   test connection -> activate. Kept as one page rather than a wizard-control
   component for the first build; splitting into real steps is a UI polish
   pass, not a data-model change. *@

<MudText Typo="Typo.h4" Class="mb-4">Onboard a store</MudText>

<MudPaper Class="pa-4" Elevation="1">
    <MudText Typo="Typo.h6">1. Store</MudText>
    <MudTextField T="string" Label="Store name" @bind-Value="_name" Required="true" Class="mb-2" />
    <MudTextField T="string" Label="Timezone (IANA id)" @bind-Value="_timezone" Placeholder="Africa/Johannesburg" Required="true" Class="mb-4" />

    <MudText Typo="Typo.h6">2. Channel connection (Order Harmony)</MudText>
    <MudTextField T="string" Label="Location key we issue" @bind-Value="_locationKey" Required="true" Class="mb-2" />
    <MudTextField T="string" Label="Webhook URL (issued by Order Harmony per environment)" @bind-Value="_webhookUrl" Required="true" Class="mb-2" />
    <MudTextField T="string" Label="Signing secret Key Vault reference" @bind-Value="_signingSecretRef" Required="true" Class="mb-4" />

    <MudText Typo="Typo.h6">3. POS connection</MudText>
    <MudSelect T="PosType" Label="POS" @bind-Value="_posType" Class="mb-2">
        <MudSelectItem Value="PosType.Pilot">Pilot</MudSelectItem>
        <MudSelectItem Value="PosType.Gaap">GAAP</MudSelectItem>
    </MudSelect>
    <MudTextField T="string" Label="@NodeIdLabel" @bind-Value="_externalNodeId" Class="mb-2" />
    <MudTextField T="string" Label="@LocationIdLabel" @bind-Value="_externalLocationId" Class="mb-2" />
    <MudTextField T="string" Label="Credential Key Vault reference" @bind-Value="_secretRef" Required="true" Class="mb-4" />

    <MudText Typo="Typo.h6">4. Billing</MudText>
    <MudSelect T="BillingPlanType" Label="Plan type" @bind-Value="_billingPlanType" Class="mb-2">
        <MudSelectItem Value="BillingPlanType.PerTransaction">Per transaction</MudSelectItem>
        <MudSelectItem Value="BillingPlanType.Flat">Flat</MudSelectItem>
    </MudSelect>
    <MudNumericField T="decimal" Label="Rate (ZAR)" @bind-Value="_rateRands" Class="mb-4" />

    <MudText Typo="Typo.h6">5. Test connection &amp; activate</MudText>
    @if (_testResult is not null)
    {
        <MudAlert Severity="@(_testResult.Healthy ? Severity.Success : Severity.Error)" Class="mb-2">
            @(_testResult.Healthy ? "Connection OK" : $"Connection failed: {_testResult.Detail}")
        </MudAlert>
    }

    <MudStack Row="true" Class="mt-4">
        <MudButton Variant="Variant.Outlined" OnClick="SaveAsDraftAndTestAsync">Save as Draft &amp; test connection</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_storeId is null || _testResult?.Healthy != true)" OnClick="ActivateAsync">
            Activate
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private string _name = "";
    private string _timezone = "Africa/Johannesburg";
    private string _locationKey = "";
    private string _webhookUrl = "";
    private string _signingSecretRef = "";
    private PosType _posType = PosType.Pilot;
    private string _externalNodeId = "";
    private string _externalLocationId = "";
    private string _secretRef = "";
    private BillingPlanType _billingPlanType = BillingPlanType.PerTransaction;
    private decimal _rateRands;
    private Guid? _storeId;
    private HealthResult? _testResult;

    private string NodeIdLabel => _posType == PosType.Gaap ? "GAAP nodeId" : "Pilot vendorId";
    private string LocationIdLabel => _posType == PosType.Gaap ? "GAAP locationId" : "Pilot siteId";

    private async Task SaveAsDraftAndTestAsync()
    {
        var store = new Store { Name = _name, Timezone = _timezone, State = StoreState.Draft };
        await StoreRepository.CreateAsync(store, CancellationToken.None);
        _storeId = store.Id;

        Db.ChannelConnections.Add(new ChannelConnection
        {
            StoreId = store.Id,
            ChannelType = ChannelType.OrderHarmony,
            LocationKey = _locationKey,
            WebhookUrl = _webhookUrl,
            SigningSecretRef = _signingSecretRef
        });

        var posConnection = new PosConnection
        {
            StoreId = store.Id,
            PosType = _posType,
            ExternalNodeId = _externalNodeId,
            ExternalLocationId = _externalLocationId,
            SecretRef = _secretRef
        };
        Db.PosConnections.Add(posConnection);

        Db.BillingRates.Add(new BillingRate
        {
            StoreId = store.Id,
            PlanType = _billingPlanType,
            RateCents = (long)(_rateRands * 100),
            EffectiveFrom = DateTimeOffset.UtcNow
        });

        await Db.SaveChangesAsync();

        var healthAdapter = Services.GetRequiredKeyedService<IPosHealthAdapter>(_posType);
        _testResult = await healthAdapter.PingAsync(posConnection, CancellationToken.None);
    }

    private async Task ActivateAsync()
    {
        if (_storeId is null)
        {
            return;
        }

        await StoreRepository.UpdateStateAsync(_storeId.Value, StoreState.Active, "Activated from onboarding wizard", CancellationToken.None);
        Nav.NavigateTo("/stores");
    }
}
