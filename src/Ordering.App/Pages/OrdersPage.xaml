<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ordering.App.Pages.OrdersPage"
             Title="My orders"
             BackgroundColor="#F8FAFC">
    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
        <VerticalStackLayout Spacing="8">
            <Button Text="Refresh" Clicked="OnRefreshClicked"
                    BackgroundColor="#0F766E" TextColor="White" HeightRequest="44" />
            <Label x:Name="ErrorLabel" TextColor="#DC2626" FontSize="16" />
        </VerticalStackLayout>
        <CollectionView x:Name="OrdersView" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnOrderSelected">
            <CollectionView.EmptyView>
                <Label Text="No orders for this location key yet." TextColor="#64748B" Margin="8" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12" Margin="0,0,0,8" BackgroundColor="White" ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="{Binding DisplayId}" TextColor="#0F172A" FontSize="20" FontAttributes="Bold" />
                            <Label Text="{Binding OrderRef}" TextColor="#64748B" FontSize="12" />
                            <Label Text="{Binding FulfillmentType}" TextColor="#64748B" FontSize="14" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Status}" TextColor="#0F766E" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
